@page "/my-magazines"
@attribute [Authorize]
@using MAUIFrontEnd.Models
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container-fluid py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-success mb-1">
                <i class="bi bi-journal-album me-2"></i>My Tour Magazines
            </h2>
            <p class="text-muted mb-0">View and download your completed tour magazines.</p>
        </div>
        <div class="col-md-6 mt-3 mt-md-0">
            <div class="search-container">
                <i class="bi bi-search text-muted"></i>
                <input type="text" class="search-input" placeholder="Search by title or code..." @bind="SearchQuery" @oninput="OnSearchInput" />
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center py-5 my-5">
            <div class="spinner-border text-teal" role="status" style="width: 3rem; height: 3rem; color: var(--ts-primary);">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted fw-medium">Fetching your magazines...</p>
        </div>
    }
    else if (filteredPackages == null || !filteredPackages.Any())
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-journal-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold text-secondary">No Magazines Found</h4>
            <p class="text-muted">You haven't completed any tours yet, or no magazines are available.</p>
        </div>
    }
    else
    {
        <div class="package-grid">
            @foreach (var pkg in filteredPackages)
            {
                <div class="package-card">
                    <div class="package-card-header">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="package-code-badge">@pkg.PackageCode</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold rounded-pill px-2.5 py-1">Completed</span>
                        </div>
                        <h4 class="package-card-title mt-2">@pkg.PackageTitle</h4>
                    </div>
                    <div class="package-card-body">
                        <div class="package-meta-item">
                            <i class="bi bi-clock-history"></i>
                            <span><strong>Duration:</strong> @pkg.DurationDays Days / @pkg.DurationNight Nights</span>
                        </div>
                    </div>
                    <div class="package-card-footer d-flex flex-wrap gap-2">
                        <button class="ts-btn-primary flex-grow-1" @onclick="() => DownloadMagazine(pkg.PackageId, pkg.PackageCode ?? pkg.PackageId.ToString())" disabled="@GetIsDownloadingMagazine(pkg.PackageId)">
                            @if (GetIsDownloadingMagazine(pkg.PackageId))
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Loading...</span>
                            }
                            else
                            {
                                <i class="bi bi-journal-album"></i>
                                <span>Download Magazine</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PackageDTO>? completedPackages;
    private List<PackageDTO>? filteredPackages;
    private string SearchQuery = "";
    private bool isLoading = true;
    private string errorMessage = "";
    private Dictionary<int, bool> isDownloadingMagazine = new();

    protected override async Task OnInitializedAsync()
    {
        await FetchMyCompletedPackages();
    }

    private async Task FetchMyCompletedPackages()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            completedPackages = await Http.GetFromJsonAsync<List<PackageDTO>>("Packages/MyCompleted");
            filteredPackages = completedPackages;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load your magazines: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        FilterPackages();
    }

    private void FilterPackages()
    {
        if (completedPackages == null) return;

        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            filteredPackages = completedPackages;
        }
        else
        {
            filteredPackages = completedPackages
                .Where(p => (p.PackageTitle != null && p.PackageTitle.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                            (p.PackageCode != null && p.PackageCode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private async Task DownloadMagazine(int packageId, string packageCode)
    {
        isDownloadingMagazine[packageId] = true;
        try
        {
            var response = await Http.GetAsync($"Magazine/packages/{packageId}/download-pdf");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"TourMagazine_{packageCode}.pdf";
                var filePath = Path.Combine(FileSystem.Current.CacheDirectory, fileName);
                await File.WriteAllBytesAsync(filePath, bytes);

                await Launcher.Default.OpenAsync(new OpenFileRequest
                {
                    Title = "Open Completed Tour Magazine",
                    File = new ReadOnlyFile(filePath)
                });
            }
            else
            {
                errorMessage = "Failed to download Tour Magazine from server.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error downloading magazine: {ex.Message}";
        }
        finally
        {
            isDownloadingMagazine[packageId] = false;
        }
    }

    private bool GetIsDownloadingMagazine(int packageId)
    {
        return isDownloadingMagazine.TryGetValue(packageId, out var downloading) && downloading;
    }
}
