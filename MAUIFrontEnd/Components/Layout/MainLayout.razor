@inherits LayoutComponentBase
@inject MAUIFrontEnd.Services.CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="page">
    <header class="app-header d-flex justify-content-between align-items-center">
        <div class="brand-title">
            <i class="bi bi-airplane-engines-fill"></i> Travel Solution
        </div>
        <nav class="d-flex gap-3 align-items-center">
            <a href="/" class="nav-link text-white fw-semibold px-2 py-1 rounded transition-all hover-teal">
                <i class="bi bi-house-door-fill me-1"></i> Home
            </a>
            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Admin") || context.User.IsInRole("Audit"))
                    {
                        <a href="/completed-tours" class="nav-link text-white fw-semibold px-2 py-1 rounded transition-all hover-teal">
                            <i class="bi bi-check-circle-fill me-1"></i> Completed Tours
                        </a>
                    }
                    else
                    {
                        <a href="/my-magazines" class="nav-link text-white fw-semibold px-2 py-1 rounded transition-all hover-teal">
                            <i class="bi bi-journal-album me-1"></i> My Magazines
                        </a>
                    }
                    <span class="text-teal-accent fw-medium px-2 py-1 rounded bg-teal-translucent d-none d-sm-inline">
                        <i class="bi bi-person-circle me-1"></i> Hello, @context.User.Identity?.Name (@(context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role || c.Type == "role" || c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value ?? "User"))
                    </span>
                    <button @onclick="Logout" class="btn btn-outline-danger btn-sm border-0 text-white fw-semibold px-2 py-1 rounded transition-all hover-danger-bg">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="nav-link text-teal fw-semibold px-2 py-1 rounded transition-all hover-teal bg-white">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main class="content-body">
        @Body
    </main>
</div>

@code {
    private void Logout()
    {
        AuthStateProvider.NotifyLogout();
        NavigationManager.NavigateTo("/");
    }
}
